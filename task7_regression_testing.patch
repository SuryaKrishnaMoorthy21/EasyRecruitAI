+    @pytest.mark.parametrize("bad", [NAN, INF], ids=["nan", "inf"])
+    def test_a_non_finite_india_adjustment_is_skipped_with_a_warning(self, _scorer, bad):
+        details = {"policy": "off", "total": bad, "cap": 15.0, "components": []}
